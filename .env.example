# Config for the root docker-compose.yml stack. Copy to .env and edit as
# needed:
#   cp .env.example .env
#
# Per-service .env files (packages/db/.env, proxy/blossom/.env,
# proxy/relay/.env) are still used for local (non-Docker) dev and for
# anything not listed here; the values below take precedence inside Docker.

# --- postgres (compose-managed) ---------------------------------------------
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
# Not published to the host by default (see the commented `ports:` entry on
# the postgres service in docker-compose.yml) — only relevant if you enable it.
POSTGRES_PORT=5435

# --- db-api -------------------------------------------------------------
# Internal-only; never published to the host.
DB_API_PORT=4000

# --- proxy/blossom --------------------------------------------------------
BLOSSOM_PORT=3001
# storage-client's blossom backend runs on the host, outside the compose
# network — reached via the host gateway. Override if your backend(s) live
# elsewhere (comma-separated list of URLs).
BLOSSOM_SERVERS=http://host.docker.internal:3000

# --- proxy/relay ------------------------------------------------------------
RELAY_PORT=8007
# storage-client's strfry backend, reached the same way as BLOSSOM_SERVERS
# above (comma-separated list of URLs).
BACKEND_RELAYS=ws://host.docker.internal:7777
