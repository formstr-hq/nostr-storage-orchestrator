# Single config file for the whole stack — both local (non-Docker) dev and
# the root docker-compose.yml stack read this same file. Copy to .env and
# edit as needed:
#   cp .env.example .env

# --- postgres (compose-managed) ---------------------------------------------
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
# Used for local (non-Docker) dev; Docker overrides both to postgres:5432
# (docker-compose.yml) — the compose-managed postgres isn't published to
# the host by default (see the commented `ports:` entry in
# docker-compose.yml), so POSTGRES_PORT only matters if you enable that.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# --- db-api -------------------------------------------------------------
# Bound to the host's loopback (127.0.0.1) only; never reachable off-box.
DB_API_PORT=4000


# --- shared by proxy/blossom and proxy/relay ---------------------------------
# Local (non-Docker) dev and docker-compose.dev.yml both reach db-api at
# localhost:$DB_API_PORT — DB_API_URL is derived from DB_API_PORT above and
# normally doesn't need setting. docker-compose.yml (NVPN mesh) reaches it at
# db:$DB_API_PORT instead via the nvpn sidecar's own bridge attachment, no
# override needed here. Uncomment only if db-api ever needs to live
# somewhere else entirely:
# DB_API_URL=http://localhost:4000

# --- proxy/blossom --------------------------------------------------------
BLOSSOM_PORT=3001
# Local dev default: storage-client's blossom backend, published on the
# host at :3000. In production (docker-compose.yml, NVPN mesh) this instead
# points at an approved storage-client's mesh tunnel IP, e.g.
# http://10.44.x.y:3000 — see docs/NVPN_SIDECAR_PLAN.md section 5
# (comma-separated list of URLs if you have more than one backend).
BLOSSOM_SERVERS=http://localhost:3000
# Optional: overrides the auto-detected base URL used in upload response
# bodies (defaults to the incoming request's own protocol+host).
# PUBLIC_BASE_URL=https://blossom.example.com

# --- proxy/relay ------------------------------------------------------------
RELAY_PORT=8007
# Local dev default: storage-client's strfry backend, published on the host
# at :7777. In production (docker-compose.yml, NVPN mesh) this instead
# points at an approved storage-client's mesh tunnel IP, e.g.
# ws://10.44.x.y:7777 — see docs/NVPN_SIDECAR_PLAN.md section 5
# (comma-separated list of URLs if you have more than one backend).
BACKEND_RELAYS=ws://localhost:7777
# Optional: overrides the relay URL used for NIP-42 AUTH challenge
# verification (defaults to ws://localhost:$RELAY_PORT). Set this to your
# public-facing relay URL in production.
# PUBLIC_URL=ws://relay.example.com

ALLOWED_NPUBS=

# --- nvpn sidecar (docker-compose.yml only; not used by docker-compose.dev.yml) ---
# See docs/NVPN_SIDECAR_PLAN.md and nvpn/README.md for the full mesh
# operator flow (invite/join/approve).
# docker-compose.yml already sets NVPN_ROLE=proxy directly on the nvpn
# service, so this doesn't need setting here — left commented out for
# reference only (uncommenting it has no effect).
# NVPN_ROLE=proxy
NVPN_LISTEN_PORT=51820
# Comma-separated TCP ports the root nvpn sidecar accepts from the Docker
# bridge (published-port path). Defaults to BLOSSOM_PORT,RELAY_PORT above —
# only set this if those ever diverge from the sidecar's own firewall rules.
# NVPN_PUBLIC_INPUT_PORTS=3001,8007
# The endpoint this proxy advertises in the invites it generates. `nvpn init`
# records whatever local address it saw, which inside a container is the
# Docker bridge IP (172.x) — useless to a remote client. Set this to the
# proxy host's reachable address so `scripts/nvpn-invite.sh` emits something
# dialable. Leave unset only when every client reaches the mesh via the FIPS
# relay fallback rather than a direct path.
# NVPN_ENDPOINT=203.0.113.10:51820
# Name given to `nvpn start --iface`; firewall.sh and healthcheck.sh key off
# the same value. Only change it if `nvpn0` collides with something.
# NVPN_TUN_IFACE=nvpn0