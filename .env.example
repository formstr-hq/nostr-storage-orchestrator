# Config for the root docker-compose.yml stack. Copy to .env and edit as
# needed:
#   cp .env.example .env
#
# Per-service .env files (packages/db/.env, proxy/blossom/.env,
# proxy/relay/.env) are still used for local (non-Docker) dev and for
# anything not listed here; the values below take precedence inside Docker.

# --- postgres (compose-managed) ---------------------------------------------
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
# Not published to the host by default (see the commented `ports:` entry on
# the postgres service in docker-compose.yml) — only relevant if you enable it.
POSTGRES_PORT=5435

# --- db-api -------------------------------------------------------------
# Bound to the host's loopback (127.0.0.1) only; never reachable off-box.
DB_API_PORT=4000

# --- proxy/blossom --------------------------------------------------------
# blossom runs with network_mode: host (see docker-compose.yml) so it can
# resolve mesh-VPN hostnames (e.g. nostr-vpn's MagicDNS) that only the
# host's own network namespace can see.
BLOSSOM_PORT=3001
# Local dev default: storage-client's blossom backend, published on the
# host at :3000. For production behind a mesh VPN, point this at your
# peer's hostname instead, e.g. http://test.nvpn:3000 (comma-separated
# list of URLs if you have more than one backend).
BLOSSOM_SERVERS=http://localhost:3000

# --- proxy/relay ------------------------------------------------------------
RELAY_PORT=8007
# storage-client's strfry backend runs on the host, outside the compose
# network — reached via the host gateway (relay stays bridge-networked).
# Override if your backend(s) live elsewhere (comma-separated list of URLs).
BACKEND_RELAYS=ws://host.docker.internal:7777
