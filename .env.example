# Single config file for the whole stack — both local (non-Docker) dev and
# the root docker-compose.yml stack read this same file. Copy to .env and
# edit as needed:
#   cp .env.example .env

# --- postgres (compose-managed) ---------------------------------------------
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
# Not published to the host by default (see the commented `ports:` entry on
# the postgres service in docker-compose.yml) — only relevant if you enable it.
POSTGRES_PORT=5435

# --- db-api -------------------------------------------------------------
# Bound to the host's loopback (127.0.0.1) only; never reachable off-box.
DB_API_PORT=4000
# DATABASE_URL is derived from the POSTGRES_* vars above + localhost for
# local (non-Docker) dev (Docker always overrides it to point at the
# compose-managed postgres instead — see docker-compose.yml). Uncomment to
# point local dev at a different database (e.g. Neon):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# --- shared by proxy/blossom and proxy/relay ---------------------------------
# Both run with network_mode: host (see docker-compose.yml), so db-api is
# always reachable at localhost:$DB_API_PORT — DB_API_URL is derived from
# DB_API_PORT above and normally doesn't need setting. Uncomment only if
# db-api ever needs to live somewhere other than localhost:
# DB_API_URL=http://localhost:4000

# --- proxy/blossom --------------------------------------------------------
BLOSSOM_PORT=3001
# Local dev default: storage-client's blossom backend, published on the
# host at :3000. For production behind a mesh VPN, point this at your
# peer's hostname instead, e.g. http://test.nvpn:3000 (comma-separated
# list of URLs if you have more than one backend).
BLOSSOM_SERVERS=http://localhost:3000
# Optional: overrides the auto-detected base URL used in upload response
# bodies (defaults to the incoming request's own protocol+host).
# PUBLIC_BASE_URL=https://blossom.example.com

# --- proxy/relay ------------------------------------------------------------
RELAY_PORT=8007
# Local dev default: storage-client's strfry backend, published on the host
# at :7777. For production behind a mesh VPN, point this at your peer's
# hostname instead, e.g. ws://test.nvpn:7777 (comma-separated list of URLs
# if you have more than one backend).
BACKEND_RELAYS=ws://localhost:7777
# Optional: overrides the relay URL used for NIP-42 AUTH challenge
# verification (defaults to ws://localhost:$RELAY_PORT). Set this to your
# public-facing relay URL in production.
# PUBLIC_URL=ws://relay.example.com
