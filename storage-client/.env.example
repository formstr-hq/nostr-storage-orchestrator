NOSTR_PORT=7777
BLOSSOM_PORT=3000

# Persistent storage paths used by docker-compose.yml.
RELAY_DATA_PATH=./data/strfry
BLOSSOM_DATA_PATH=./data/blossom

# --- nvpn sidecar (docker-compose.yml only; not used by docker-compose.dev.yml) ---
# Join the proxy operator's mesh once, then bring the stack up:
#   ./scripts/nvpn-join.sh
#   docker compose up -d --build
# See ../docs/NVPN_SIDECAR_PLAN.md and ../nvpn/README.md for the full flow.
# docker-compose.yml already sets NVPN_ROLE=client directly on the nvpn
# service; kept here too for reference (uncommenting/editing has no effect).
NVPN_ROLE=client
NVPN_LISTEN_PORT=51820
# Comma-separated TCP ports the client nvpn sidecar accepts from loopback and
# the mesh tunnel interface only (never from the Docker bridge). Defaults
# match this stack's blossom/strfry ports; only set this if those change.
# NVPN_MESH_INPUT_PORTS=3000,7777

# --- storage-agent ----------------------------------------------------------
# The agent signs reports with this storage machine's own nVPN nsec from
# nvpn_data; no operator key or duplicate secret belongs in this file.
# Normally derived from the self-contained invite and nvpn0 peer route. Set
# these only to override discovery in a non-standard mesh.
CONTROL_PLANE_HOST_NPUB=
CONTROL_PLANE_HOST_TUNNEL_IP=
CONTROL_PLANE_API_PORT=3002
# Loopback-only health endpoint in the shared nVPN network namespace.
AGENT_HEALTH_PORT=3010
PING_INTERVAL_SECS=300
PING_RETRY_SECS=15
