// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Legacy plan enum. No longer referenced by any model — `User.plan` is now a
// nullable text column holding plan ids owned by formstr-backend. Kept in the
// schema for now so the additive entitlements migration does not drop the
// Postgres type; a follow-up cleanup migration may remove it.
enum Plan {
  FREE
  BASIC
  PRO
}

enum UserStatus {
  UNPAID
  ACTIVE
  GRACE
  WRITE_BLOCKED
  READ_BLOCKED
  CLOSED
}

enum MemberRole {
  CLIENT
  ADMIN
}

enum MemberStatus {
  ACTIVE
  REVOKED
}

enum StorageLifecycle {
  LINKED
  REMOVED
}

model Blob {
  hash      String   @id
  npub      String
  size      BigInt
  replicas  String[]
  createdAt DateTime @default(now())

  user User @relation(fields: [npub], references: [npub])
}

model User {
  npub            String     @id
  /**
   * Internal role. "user" (default) is a blob owner; "service" and "admin"
   * may call the internal entitlement/admin endpoints. Registered out of
   * band with scripts/registerService.ts; never set from a request body.
   */
  role            String     @default("user")
  plan            String?
  planExpiresAt   DateTime?
  storageBytes    BigInt?
  status          UserStatus @default(UNPAID)
  statusChangedAt DateTime?
  termsVersion    String?
  termsAcceptedAt DateTime?
  usedStorage     BigInt     @default(0)
  createdAt       DateTime   @default(now())

  blobs Blob[]

  @@index([status])
  @@index([planExpiresAt])
  @@index([role])
}

// Dedupe log for expiry/quota/moderation/purchase notifications. Both channels
// are attempted independently; the unique key stops repeat sends for the same
// (npub, kind, ref, channel).
model NotificationLog {
  id      String   @id @default(cuid())
  npub    String
  kind    String
  ref     String?
  channel String
  sentAt  DateTime @default(now())

  @@unique([npub, kind, ref, channel])
  @@index([npub, sentAt])
}

// Admin moderation audit. Money-related records never live here.
model ModerationAction {
  id        String   @id @default(cuid())
  hash      String
  npub      String
  adminNpub String
  reason    String
  createdAt DateTime @default(now())

  @@index([hash])
  @@index([npub])
}

model Member {
  npub        String       @id
  role        MemberRole   @default(CLIENT)
  status      MemberStatus @default(ACTIVE)
  addedByNpub String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  storages Storage[]
}

model Storage {
  npub                  String           @id
  ownerNpub             String
  owner                 Member           @relation(fields: [ownerNpub], references: [npub])
  tunnelIp              String?
  blossomPort           Int?
  pgAgentPort           Int?
  declaredCapacityBytes BigInt?
  reportedTotalBytes    BigInt?
  reportedFreeBytes     BigInt?
  lifecycle             StorageLifecycle @default(LINKED)
  lastPingAt            DateTime?
  createdAt             DateTime         @default(now())

  @@index([lifecycle, lastPingAt])
  @@index([ownerNpub])
}

// ── Decentralized Postgres layer (docs/DECENTRALIZED_PG_PLAN.md) ────────────
// Owned by the pg-gateway, which talks to these tables directly over
// tokio-postgres; they are declared here so Prisma owns the schema/migrations.

model PgTable {
  name      String   @id
  columns   Json
  version   Int      @default(1)
  replicaN  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pg_table")
}

model PgMigration {
  id        String    @id
  ddl       String
  version   Int
  state     String    @default("PENDING")
  createdAt DateTime  @default(now())
  appliedAt DateTime?

  @@index([state, version])
  @@map("pg_migration")
}

model PgMigrationState {
  storageNpub String   @map("storage_npub")
  version     Int
  appliedAt   DateTime @default(now())

  @@id([storageNpub, version])
  @@map("pg_migration_state")
}

model PgWriteOp {
  id             String    @id
  tableName      String    @map("table_name")
  op             String
  rowId          String    @map("row_id")
  payload        Json?
  createdAt      DateTime  @default(now())
  retryCount     Int       @default(0)
  lastError      String?   @map("last_error")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  @@index([tableName, rowId])
  @@index([createdAt])
  @@map("pg_write_op")
}

model PgPlacement {
  tableName String   @map("table_name")
  rowId     String   @map("row_id")
  replicas  String[]
  state     String   @default("PENDING")
  updatedAt DateTime @updatedAt

  @@id([tableName, rowId])
  @@map("pg_placement")
}
