// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All Prisma-owned tables/columns are lowercase snake_case in Postgres via
// @@map/@map. Prisma field names stay camelCase; db-api JSON serialization is
// unchanged. The pg_* models below are the exception: they are owned by
// pg-gateway's raw tokio-postgres SQL and keep their existing names.

// ── Paid users ──────────────────────────────────────────────────────────────
// Only users with an entitlement live here. There is no service/admin role:
// machine callers live in service_account, and admin-ness is owned by
// formstr-backend (the proxy calls its admin-check endpoint). Plans (labels,
// prices, invoices) live in formstr-backend too; this repo stores only the
// entitlement fields it must enforce: expiry and allowance.

model User {
  npub          String    @id
  planExpiresAt DateTime? @map("plan_expires_at")
  storageBytes  BigInt?   @map("storage_bytes")
  usedStorage   BigInt    @default(0) @map("used_storage")
  createdAt     DateTime  @default(now()) @map("created_at")

  blobs Blob[]

  @@index([planExpiresAt])
  @@map("user")
}

model Blob {
  hash      String   @id
  npub      String
  size      BigInt
  replicas  String[]
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [npub], references: [npub])

  @@map("blob")
}

// ── Service accounts ─────────────────────────────────────────────────────────
// Machine identities allowed to call the internal db-api endpoints. Proven
// per-request with a NIP-98 header; the signer's npub must have a row here
// with enabled = true. Registered out of band with `npm run register:service`.
// No roles: everything in this table is privileged the same way.

model ServiceAccount {
  npub      String   @id
  label     String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_account")
}

// Dedupe log for expiry/quota/moderation/purchase notifications. Both channels
// are attempted independently; the unique key stops repeat sends for the same
// (npub, kind, ref, channel).
model NotificationLog {
  id      String   @id @default(cuid())
  npub    String
  kind    String
  ref     String?
  channel String
  sentAt  DateTime @default(now()) @map("sent_at")

  @@unique([npub, kind, ref, channel])
  @@index([npub, sentAt])
  @@map("notification_log")
}

// Admin moderation audit. Money-related records never live here.
model ModerationAction {
  id        String   @id @default(cuid())
  hash      String
  npub      String
  adminNpub String   @map("admin_npub")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([hash])
  @@index([npub])
  @@map("moderation_action")
}

// ── Mesh membership ──────────────────────────────────────────────────────────
// Members of the storage mesh (not formstr users/admins). MESH_ROLE admin is a
// mesh administrator, a different concept from the formstr-backend admins the
// console checks. Soft-deleted via status = REVOKED.

model MeshMember {
  npub        String     @id
  role        MeshRole   @default(CLIENT) @map("mesh_role")
  status      MeshStatus @default(ACTIVE)
  addedByNpub String?    @map("added_by_npub")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  storages StorageProvider[]

  @@map("mesh_member")
}

enum MeshRole {
  CLIENT
  ADMIN

  @@map("mesh_role")
}

enum MeshStatus {
  ACTIVE
  REVOKED

  @@map("mesh_status")
}

// ── Storage providers ─────────────────────────────────────────────────────────
// Machines that serve blobs and/or a mesh-PG (pg-agent) endpoint. Written by
// control-plane-backend and the storage agents; read by the proxy provider
// registry and pg-gateway. Soft-deleted via lifecycle = REMOVED.

model StorageProvider {
  npub                  String           @id
  ownerNpub             String           @map("owner_npub")
  owner                 MeshMember       @relation(fields: [ownerNpub], references: [npub])
  tunnelIp              String?          @map("tunnel_ip")
  blossomPort           Int?             @map("blossom_port")
  pgAgentPort           Int?             @map("pg_agent_port")
  declaredCapacityBytes BigInt?          @map("declared_capacity_bytes")
  reportedTotalBytes    BigInt?          @map("reported_total_bytes")
  reportedFreeBytes     BigInt?          @map("reported_free_bytes")
  lifecycle             StorageLifecycle @default(LINKED)
  lastPingAt            DateTime?        @map("last_ping_at")
  createdAt             DateTime         @default(now()) @map("created_at")

  @@index([lifecycle, lastPingAt])
  @@index([ownerNpub])
  @@map("storage_provider")
}

enum StorageLifecycle {
  LINKED
  REMOVED

  @@map("storage_lifecycle")
}

// ── Decentralized Postgres layer (docs/DECENTRALIZED_PG_PLAN.md) ────────────
// Owned by the pg-gateway, which talks to these tables directly over
// tokio-postgres; they are declared here so Prisma owns the schema/migrations.
// Names are intentionally left as-is (quoted camelCase columns) to match
// CENTRAL_SCHEMA_SQL in pg-gateway/src/central.rs and its raw SQL.

model PgTable {
  name      String   @id
  columns   Json
  version   Int      @default(1)
  replicaN  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pg_table")
}

model PgMigration {
  id        String    @id
  ddl       String
  version   Int
  state     String    @default("PENDING")
  createdAt DateTime  @default(now())
  appliedAt DateTime?

  @@index([state, version])
  @@map("pg_migration")
}

model PgMigrationState {
  storageNpub String   @map("storage_npub")
  version     Int
  appliedAt   DateTime @default(now())

  @@id([storageNpub, version])
  @@map("pg_migration_state")
}

model PgWriteOp {
  id             String    @id
  tableName      String    @map("table_name")
  op             String
  rowId          String    @map("row_id")
  payload        Json?
  createdAt      DateTime  @default(now())
  retryCount     Int       @default(0)
  lastError      String?   @map("last_error")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  @@index([tableName, rowId])
  @@index([createdAt])
  @@map("pg_write_op")
}

model PgPlacement {
  tableName String   @map("table_name")
  rowId     String   @map("row_id")
  replicas  String[]
  state     String   @default("PENDING")
  updatedAt DateTime @updatedAt

  @@id([tableName, rowId])
  @@map("pg_placement")
}
