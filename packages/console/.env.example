# Backend base URL for formstr-backend (plans, invoices, role, email notify).
# Local dev default is https://api.formstr.app; production builds must set this
# to the public backend origin.
# VITE_BACKEND_URL=https://backend.example.com

# Blossom proxy base. Empty (the default) means same origin as the console,
# which is how the proxy serves it in production.
# VITE_BLOSSOM_URL=
