# Copy to .env and fill secrets before `docker compose up`.
# chmod 600 .env

# Relay signing / session secret.
SECRET=change_me_openssl_rand_hex_32

# mesh-PG gateway credentials. DB_PASSWORD must equal the orchestrator's
# PG_GATEWAY_PASSWORD (the pg-gateway password).
DB_HOST=172.17.0.1
DB_PORT=55432
DB_USER=orchestrator
DB_PASSWORD=change_me_pg_gateway_password
DB_NAME=nostr_ts_relay
DB_MIN_POOL_SIZE=0
DB_MAX_POOL_SIZE=8
DB_ACQUIRE_CONNECTION_TIMEOUT=60000

# Redis sidecar (internal to the compose network).
REDIS_USER=default
REDIS_PASSWORD=change_me_openssl_rand_hex_32

# nostream image. Built from the fork and loaded locally; compose never pulls.
NOSTREAM_IMAGE=nostream-mesh:staging

LOG_LEVEL=info
